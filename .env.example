# Hugging Face 토큰 (Inference Providers 사용 권한 필요)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 실제 사용 가능한 Stable Audio 3 모델 슬러그로 교체 (Hugging Face 모델 허브에서 확인)
HF_STABLE_AUDIO_MODEL=stabilityai/stable-audio-3

# Firebase 서비스 계정 키 JSON 파일 경로 (Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OpenAI (오케스트라 악보 생성 - MusicXML)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
